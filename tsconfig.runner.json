{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".tmp-test-dist",
    "rootDir": ".",
    "incremental": false,
    "sourceMap": false
  },
  "include": [
    "types/**/*.ts",
    "constants/**/*.ts",
    "lib/**/*.ts",
    "app/api/**/*.ts",
    "evaluation/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "components/chat/AIResponseRenderer.tsx",
    "components/ui/RichText.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".tmp-test-dist"
  ]
}
